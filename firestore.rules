rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fas 1: publikt läsbart innehåll, inga skrivningar utifrån.
    // Fas 2: skrivningar öppnas upp för inloggad personal (Firebase Auth) via adminsidan.
    match /{document=**} {
      allow read: if true;
      // Fas 2: skrivningar sker via adminsidan, inloggad med Firebase Auth.
      allow write: if request.auth != null;
    }
  }
}
